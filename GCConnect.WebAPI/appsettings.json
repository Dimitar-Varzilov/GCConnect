{
  "Okta": {
    "OktaDomain": "<OKTA_DOMAIN>",
    "AuthorizationServerId": "<AUTHORIZATION_SERVER_ID>",
    "Audience": "<OKTA_AUDIENCE>"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information"
    }
  },
  "ConnectionStrings": {
    "Sql": "<SQL_CONNECTION_STRING>"
  },
  "Cors": {
    "AllowedOrigins": [
      "https://your-production-domain.com"
    ]
  },
  "AllowedHosts": "*"
}