{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run ASP.NET Core WebAPI",
            "type": "shell",
            "command": "dotnet run --project ./GCConnect.WebAPI/GCConnect.WebAPI.csproj",
            "group": "build",
            "problemMatcher": ["$msCompile"]
        },
        {
            "label": "Start Angular UI",
            "type": "shell",
            "command": "npm start",
            "options": {
                "cwd": "${workspaceFolder}/GCConnect.Client"
            },
            "isBackground": true,
            "group": "build",
            "problemMatcher": ["$tsc"]
        }
    ]
}
