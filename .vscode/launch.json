{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "compounds": [
        {
            "name": "Full Stack Launch",
            "configurations": [
                "SQL Server",
                ".NET WebAPI",
                "Angular UI"
            ]
        }
    ],
    "configurations": [
        {
            "name": "SQL Server",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "Run SQL Server",
            "program": "${workspaceFolder}/GCConnect.WebAPI/bin/Debug/net9.0/GCConnect.WebAPI.dll",
            "cwd": "${workspaceFolder}/GCConnect.WebAPI",
            "stopAtEntry": false
        },
        {
            "name": ".NET WebAPI",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "Build ASP.NET Core WebAPI",
            "program": "${workspaceFolder}/GCConnect.WebAPI/bin/Debug/net9.0/GCConnect.WebAPI.dll",
            "args": [],
            "cwd": "${workspaceFolder}/GCConnect.WebAPI",
            "stopAtEntry": false,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "Now listening on: (https?://\\S+)"
            },
            "env": {},
            "sourceFileMap": {
                "/Views": "${workspaceFolder}/Views"
            }
        },
        {
            "name": "Angular UI",
            "type": "chrome",
            "request": "launch",
            "preLaunchTask": "Start Angular UI",
            "url": "http://localhost:4200",
            "webRoot": "${workspaceFolder}/GCConnect.Client/src"
        }
    ]
}